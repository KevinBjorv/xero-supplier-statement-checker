{
  "name": "xero-supplier-statement-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "build": "node scripts/build.mjs",
    "workflow:check": "node scripts/build.mjs --check",
    "demo": "node scripts/demo.mjs",
    "check": "npm run typecheck && npm test && npm run workflow:check",
    "test:openai": "node --env-file=.env.local scripts/test-openai.mjs"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "lossless-json": "4.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
